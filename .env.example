# --- LLM Provider ---
# Option 1: Google Gemini via AI Studio (default for local dev)
GEMINI_API_KEY=REPLACE_ME

# Option 2: Google Gemini via Vertex AI (production on GCP)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Option 3: Red Hat MaaS (OpenAI-compatible Gemini proxy on RHOAI)
# Requires: pip install rh-maas-litellm
# MAAS_BASE_URL=https://maas.apps.ocp.example.com
# MAAS_API_KEY=sk-oai-...

# --- Agent Model ---
MODEL_NAME=gemini-2.5-flash

# --- Safety Judge Model (used by the content-safety plugin) ---
# SAFETY_JUDGE_MODEL=gemini-2.5-flash

# --- Coding Agent (OpenCode) ---
# The ExecuteBashTool runs opencode/mvn directly.
# Set CODING_MODEL for the model OpenCode should use.
# CODING_MODEL=provider/model-name

# --- SCM ---
# SCM_PROVIDER=gitlab
# SCM_HOST=gitlab.example.com
# SCM_TOKEN=REPLACE_ME
# SCM_USERNAME=oauth2
# SCM_BASE_BRANCH=main

# --- Workspace ---
# WORKSPACE_PATH=/workspace/source

# --- EvalHub (RHOAI 3.5 evaluation orchestration) ---
# EVALHUB_URL=https://evalhub-redhat-ods-applications.apps.example.com
# EVALHUB_TENANT=redhat-ods-applications
# EVALHUB_TOKEN=  (oc create token <sa> -n <namespace>)
# EVALHUB_MODEL_URL=http://ogx-service.namespace.svc:8321/v1
# EVALHUB_MODEL_NAME=gemini-2.5-flash

# --- MLflow Tracing (RHOAI 3.5) ---
# Set MLFLOW_TRACKING_URI to enable tracing. If unset, tracing is disabled.
# MLFLOW_TRACKING_URI=https://mlflow-redhat-ods-applications.apps.example.com
# MLFLOW_EXPERIMENT_NAME=lw-agents
# MLFLOW_WORKSPACE=autorag
# MLFLOW_TRACKING_TOKEN=  (oc whoami -t or oc create token <sa>)
# MLFLOW_TRACKING_INSECURE_TLS=false
# MLFLOW_HEALTH_CHECK_TIMEOUT=5

# --- Container Images (for build/push/deploy) ---
# CONTAINER_IMAGE=quay.io/<org>/lw-agents:latest
# SANDBOX_IMAGE=quay.io/<org>/lw-agents-sandbox:latest
