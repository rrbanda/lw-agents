# --- LLM Provider ---
# Google Gemini via AI Studio (default for local dev)
GEMINI_API_KEY=REPLACE_ME

# Or: Google Gemini via Vertex AI (production)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Agent Model ---
MODEL_NAME=gemini-2.5-flash

# --- Coding Agent (OpenCode) ---
# The ExecuteBashTool runs opencode/mvn directly.
# Set CODING_MODEL for the model OpenCode should use.
# CODING_MODEL=provider/model-name

# --- SCM ---
# SCM_PROVIDER=gitlab
# SCM_HOST=gitlab.example.com
# SCM_TOKEN=REPLACE_ME
# SCM_USERNAME=oauth2

# --- Workspace ---
# WORKSPACE_PATH=/workspace/source
